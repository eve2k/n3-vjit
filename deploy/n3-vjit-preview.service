[Unit]
Description=N3 VJIT LAN preview
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/eve/workspace/website/n3-vjit-webapp
Environment=PATH=/home/eve/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/eve/.local/bin/node /home/eve/workspace/website/n3-vjit-webapp/node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 4173 --strictPort
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
