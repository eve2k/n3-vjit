[Unit]
Description=N3 VJIT website (Caddy)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/eve/workspace/website/n3-vjit-webapp
ExecStart=/home/eve/.local/bin/caddy run --config /home/eve/.config/n3-vjit/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
